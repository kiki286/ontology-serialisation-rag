# --- service URLs ---
BACKEND_URL=http://backend:8000
RAG_URL=http://rag:9000

# --- langchain / openai ---
OPENAI_API_KEY=""
LANGSMITH_API_KEY=""
LANGSMITH_TRACING="true"
RETRIEVAL_K=20